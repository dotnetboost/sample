<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- ──────────────────────────────────────────────────────────────────────────
       The three DotNetBoost libraries, straight from nuget.org.

       Note what is NOT here: no DotNetBoost.Core, no DotNetBoost.Abstractions, no
       integration package pairing two of them. Each library is installed on its own
       and knows nothing about the others. tests/ asserts that stays true.
       ────────────────────────────────────────────────────────────────────────── -->
  <ItemGroup Label="DotNetBoost — Settings">
    <PackageVersion Include="DotNetBoost.Settings.Core" Version="1.0.0-preview.2" />
    <PackageVersion Include="DotNetBoost.Settings.EntityFrameworkCore" Version="1.0.0-preview.2" />
    <PackageVersion Include="DotNetBoost.Settings.API" Version="1.0.0-preview.2" />
    <!-- Server-side rules for the settings groups, and the source of the constraints the
         schema endpoint publishes — so the dashboard's generated form reads them rather than
         hardcoding a range it guessed at. -->
    <PackageVersion Include="DotNetBoost.Settings.FluentValidation" Version="1.0.0-preview.2" />
  </ItemGroup>

  <ItemGroup Label="DotNetBoost — Media">
    <PackageVersion Include="DotNetBoost.Media.Core" Version="1.0.0-preview.2" />
    <PackageVersion Include="DotNetBoost.Media.EntityFrameworkCore" Version="1.0.0-preview.2" />
    <PackageVersion Include="DotNetBoost.Media.FileSystem" Version="1.0.0-preview.2" />
    <PackageVersion Include="DotNetBoost.Media.API" Version="1.0.0-preview.2" />
  </ItemGroup>

  <ItemGroup Label="DotNetBoost — MultiLingual">
    <PackageVersion Include="DotNetBoost.MultiLingual.Core" Version="1.0.0-preview.2" />
    <PackageVersion Include="DotNetBoost.MultiLingual.EntityFrameworkCore" Version="1.0.0-preview.2" />
    <PackageVersion Include="DotNetBoost.MultiLingual.API" Version="1.0.0-preview.2" />
    <!-- IStringLocalizer over Resources/*.json, answering in the language the CONTENT is served
         in. Still one library's family, so the independence tests are unaffected. -->
    <PackageVersion Include="DotNetBoost.MultiLingual.Localization" Version="1.0.0-preview.2" />
  </ItemGroup>

  <!-- ──────────────────────────────────────────────────────────────────────────
       Persistence — PostgreSQL through EF Core, one version per target framework.

       Domain, Application and Infrastructure multi-target net8.0;net10.0, matching the TFMs the
       DotNetBoost packages themselves ship. EF Core does not: 10.x requires net10.0. So the
       version is chosen per TFM — these conditions are evaluated once per pass of the outer
       build, which is what makes central package management work across frameworks at all.

       The versions are the ones the DotNetBoost EF packages ask for on each TFM (8.0.30 and
       10.0.11). Naming a lower one would be a package DOWNGRADE against a transitive
       requirement — NU1605, an error — which is the trap to know about when adding a direct
       reference to something a library already depends on.
       ────────────────────────────────────────────────────────────────────────── -->
  <ItemGroup Label="Persistence — net8.0" Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.30" />
    <!-- The provider's own 8.x line tops out at 8.0.11, which wants EF 8.0.11 — an UPGRADE to
         8.0.30 above, not a downgrade, so the two sit together without complaint. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Label="Persistence — net10.0" Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- ──────────────────────────────────────────────────────────────────────────
       Request validation.

       DotNetBoost.Settings.FluentValidation already brings this in for the settings groups'
       rules. Application takes it DIRECTLY as well, for the validators that bound a command or
       query before its handler runs — a different job, done by the same library, and a direct
       reference is how a project says it uses something rather than inheriting it.

       Pinned to the version that library resolves to, so there is one FluentValidation in the
       build rather than two opinions about it.
       ────────────────────────────────────────────────────────────────────────── -->
  <ItemGroup Label="Validation">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="Aspire — AppHost (orchestration)">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.3" />
  </ItemGroup>

  <ItemGroup Label="Aspire — service defaults and integrations">
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.5.3" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup Label="API surface">
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.12" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Boots the real Program.cs in-process; the integration tests drive it over HTTP. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
    <!-- A throwaway PostgreSQL per test run. The README already asks for a container runtime to
         run the sample at all, so this adds no prerequisite — and the tests skip without one. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

</Project>
