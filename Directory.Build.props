<Project>

  <PropertyGroup>
    <!-- No TargetFramework here on purpose. The three class libraries multi-target
         net8.0;net10.0, matching the TFMs the DotNetBoost packages themselves ship, and the host
         is pinned to net10.0 by Aspire and the Npgsql EF Core provider. A single default here
         would have to be overridden by every project that disagrees with it, and MSBuild cannot
         see a csproj's TargetFrameworks from this file to make the default conditional — so each
         project states its own, once. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
