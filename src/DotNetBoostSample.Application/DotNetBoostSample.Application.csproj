<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core, for the endpoint that sits in each slice">
    <!-- A slice holds its own route. That is the whole payoff of this layout — one file per
         feature, deletable in one `rm` — and protecting this project from IResult would cost it,
         by splitting every feature across two projects. The rule that was doing real work is kept
         instead: handlers return Result<T>, never IResult, so they are testable with no host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Label="The three libraries — abstractions only">
    <!-- Core and nothing else. No *.EntityFrameworkCore, no *.FileSystem, no *.API: this project
         says what it wants done, and Infrastructure decides which store does it. -->
    <PackageReference Include="DotNetBoost.Settings.Core" />
    <PackageReference Include="DotNetBoost.Media.Core" />
    <PackageReference Include="DotNetBoost.MultiLingual.Core" />
    <!-- No DotNetBoost.Auditing here: the write slices do not record their own changes, because
         the change-tracker capture attached to the DbContext in Infrastructure does it for them.
         The [AuditIgnore] attributes on the two entities come with Domain. -->
  </ItemGroup>

  <ItemGroup Label="Querying">
    <!-- EF Core itself, not the Npgsql provider — which is the dependency rule that earns its
         keep. Handlers read `db.Products` through IAppDbContext, and they have to: MultiLingual's
         interceptors are what make a plain ToListAsync() come back already translated, so routing
         reads through repositories would hide the sample's best trick. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DotNetBoostSample.Domain/DotNetBoostSample.Domain.csproj" />
  </ItemGroup>

</Project>
