<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup Label="Where each library's data actually goes">
    <PackageReference Include="DotNetBoost.Settings.EntityFrameworkCore" />
    <PackageReference Include="DotNetBoost.Settings.FluentValidation" />
    <PackageReference Include="DotNetBoost.Media.EntityFrameworkCore" />
    <PackageReference Include="DotNetBoost.Media.FileSystem" />
    <PackageReference Include="DotNetBoost.MultiLingual.EntityFrameworkCore" />
    <PackageReference Include="DotNetBoost.MultiLingual.Localization" />
    <!-- Auditing's store is the application's own AppDbContext, which is what lets an audit row
         be committed by the same SaveChanges as the change it describes. The capture comes with
         it: UseAuditing(sp) on the context, in DependencyInjection.cs. -->
    <PackageReference Include="DotNetBoost.Auditing.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup Label="PostgreSQL">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DotNetBoostSample.Application/DotNetBoostSample.Application.csproj" />
  </ItemGroup>

</Project>
