<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net10.0 only. Aspire 13.5 and the Npgsql EF Core 10 provider both require it, so the host
         cannot follow the class libraries onto net8.0 — which is where multi-targeting is worth
         having anyway: the slices are proved against DotNetBoost's own net8.0 TFM. -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup Label="Each library's own HTTP endpoints — mapped, not written">
    <PackageReference Include="DotNetBoost.Settings.API" />
    <PackageReference Include="DotNetBoost.Media.API" />
    <PackageReference Include="DotNetBoost.MultiLingual.API" />
    <!-- Also the only package that can supply the actor: UseHttpContextActor() needs
         HttpContext, so it is passed into AddInfrastructure from here the same way
         ExposeOverHttp is. -->
    <PackageReference Include="DotNetBoost.Auditing.API" />
  </ItemGroup>

  <ItemGroup Label="API docs">
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DotNetBoostSample.Application/DotNetBoostSample.Application.csproj" />
    <ProjectReference Include="../DotNetBoostSample.Infrastructure/DotNetBoostSample.Infrastructure.csproj" />
    <ProjectReference Include="../../aspire/DotNetBoostSample.ServiceDefaults/DotNetBoostSample.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
