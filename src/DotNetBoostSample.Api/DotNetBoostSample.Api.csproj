<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup Label="DotNetBoost — three independent libraries, installed side by side">
    <!-- Settings: runtime-editable configuration, stored in PostgreSQL. -->
    <PackageReference Include="DotNetBoost.Settings.Core" />
    <PackageReference Include="DotNetBoost.Settings.EntityFrameworkCore" />
    <PackageReference Include="DotNetBoost.Settings.API" />

    <!-- Media: file metadata in PostgreSQL, bytes on local disk. -->
    <PackageReference Include="DotNetBoost.Media.Core" />
    <PackageReference Include="DotNetBoost.Media.EntityFrameworkCore" />
    <PackageReference Include="DotNetBoost.Media.FileSystem" />
    <PackageReference Include="DotNetBoost.Media.API" />

    <!-- MultiLingual: per-language entity translations, stored in PostgreSQL. -->
    <PackageReference Include="DotNetBoost.MultiLingual.Core" />
    <PackageReference Include="DotNetBoost.MultiLingual.EntityFrameworkCore" />
    <PackageReference Include="DotNetBoost.MultiLingual.API" />
    <PackageReference Include="DotNetBoost.MultiLingual.Localization" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup Label="API docs">
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../aspire/DotNetBoostSample.ServiceDefaults/DotNetBoostSample.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
